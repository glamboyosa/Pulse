SESSION_SECRET=at-least-32-random-characters
SERVER_URL=http://localhost:3000

ELEVEN_LABS_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
